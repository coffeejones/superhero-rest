          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Favoritten findes præcis én gang med sin note\", () => {",
              "  const favorites = pm.response.json();",
              "  pm.expect(favorites).to.be.an(\"array\");",
              "  favorites.forEach(favorite => pm.expect(favorite).to.have.all.keys(\"id\", \"note\"));",
              "  const matches = favorites.filter(favorite => favorite.id === Number(pm.collectionVariables.get(\"heroId\")));",
              "  pm.expect(matches).to.deep.equal([{ id: Number(pm.collectionVariables.get(\"heroId\")), note: \"Min yndlingshelt!\" }]);",
              "});"
