{
  "info": {
    "name": "SuperHero REST · CRUD og validering",
    "description": "Kør requests i rækkefølge med Collection Runner eller npm run test:postman. Første request finder test-ID ud fra de aktuelle API-data. Collectionen fjerner først en eventuel favorit med dette ID og sletter sin testfavorit til sidst. Brug en testserver: en eksisterende note for dette ID genskabes ikke. Ingen øvrige favoritter ændres. SuperHero API skal være tilgængeligt.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 · Hent alle superhelte",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/superheroes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const heroes = pm.response.json();",
              "pm.test(\"Listen indeholder kun de fem krævede felter\", () => {",
              "  pm.expect(heroes).to.be.an(\"array\").that.is.not.empty;",
              "  heroes.forEach(hero => {",
              "    pm.expect(hero).to.have.all.keys(\"id\", \"name\", \"fullName\", \"strength\", \"image\");",
              "    pm.expect(hero.id).to.be.a(\"number\");",
              "    pm.expect(hero.name).to.be.a(\"string\");",
              "    pm.expect(hero.fullName).to.be.a(\"string\");",
              "    pm.expect(hero.strength === null || typeof hero.strength === \"number\").to.equal(true);",
              "    pm.expect(hero.image).to.be.a(\"string\");",
              "  });",
              "});",
              "if (Array.isArray(heroes) && heroes.length) {",
              "  pm.collectionVariables.set(\"heroId\", heroes[0].id);",
              "  pm.collectionVariables.set(\"selectedHero\", JSON.stringify(heroes[0]));",
              "  pm.collectionVariables.set(\"missingHeroId\", Math.max(...heroes.map(hero => hero.id)) + 1);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Hent den valgte superhelt",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/superheroes/{{heroId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Den korrekte superhelt returneres\", () => {",
              "  pm.expect(pm.response.json()).to.deep.equal(JSON.parse(pm.collectionVariables.get(\"selectedHero\")));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · Ukendt superhelt giver 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/superheroes/{{missingHeroId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Informativ JSON-fejl\", () => {",
              "  pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · Klargør favorit til testen",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/favorites/{{heroId}}",
        "description": "Fjerner en eventuel eksisterende favorit for den først returnerede superhelt. Kør mod en testserver: denne request ændrer serverens favoritter."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Favoritten er fjernet eller fandtes ikke\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([204, 404]);",
              "});"
            ]
          }
        }
      ]
    },
